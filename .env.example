# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor. Nunca exponer al cliente. Se usa en los endpoints públicos del participante.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública de la app (para construir la liga mágica) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Candado anti-repetición ---
# Secreto para firmar la cookie de dispositivo y salar el hash de IP. Generar con: openssl rand -hex 32
PARTICIPANT_LOCK_SECRET=

# --- Análisis con IA: cascada de proveedores ---
# Orden por defecto (de menor a mayor costo): Gemini gratuito (potente → menos potente) →
# Claude Haiku → Gemini de paga barato → Claude Sonnet → Gemini de paga caro → Claude (último).
# Pasa al siguiente nivel si uno falla o se queda sin cuota.
# Los niveles sin API key se omiten. Pon las claves SOLO aquí / en Vercel, nunca en el repo.
#   GEMINI_API_KEY_FREE : key de un proyecto de Google SIN facturación (Google AI Studio).
#   GEMINI_API_KEY_PAID : key de un proyecto de Google CON facturación activa.
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
ANTHROPIC_API_KEY=
# Modelo del ÚLTIMO nivel (Claude). Vacío = claude-opus-5-5. Haiku y Sonnet van fijos en la cascada.
ANTHROPIC_MODEL=
# Opcional: orden y modelos de la cascada, separados por coma. Tipos: gemini-free:MODELO,
# gemini-paid:MODELO, anthropic[:MODELO], openai:MODELO. Vacío = el orden por defecto:
#   gemini-free:gemini-3.8-flash,gemini-free:gemini-3.5-flash-lite,anthropic:claude-haiku-5-5,gemini-paid:gemini-3.8-flash,anthropic:claude-sonnet-5-5,gemini-paid:gemini-4-argon,anthropic
# Los nombres de modelo de Gemini cambian: confírmalos en Google AI Studio.
AI_CASCADE=

# Modo anterior (un solo proveedor). Solo aplica si NO hay claves de Gemini ni AI_CASCADE.
# anthropic | openai
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Auditoría SEO (opcional) ---
# Clave de la API de PageSpeed Insights (Google Cloud). Sin clave la cuota es muy baja.
PAGESPEED_API_KEY=
